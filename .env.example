# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL Connection String
# Compatible with Neon, Supabase, Render PostgreSQL, Railway, AWS RDS, or Local Postgres:
# postgresql://postgres:password@localhost:5432/ai_project_hub?sslmode=disable
# postgres://user:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_project_hub"
